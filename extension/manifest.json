{
  "manifest_version": 3,
  "name": "X Auto SOP",
  "version": "0.1.0",
  "description": "按《X 新人浏览互动 SOP》自动刷推：先读后动、独立判断、拟人键鼠（CDP 可信事件）、逐字 130ms 输入",
  "permissions": ["debugger", "storage", "tabs", "scripting", "sidePanel", "alarms"],
  "host_permissions": ["https://x.com/*", "https://api.deepseek.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["sop.js", "comment.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "打开 X Auto SOP 面板" }
}
